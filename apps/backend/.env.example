# ---- Server ----
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=debug

# ---- CORS ----
CORS_ORIGIN=http://localhost:3000

# ---- Postgres ----
# Migrations run as the owner; the runtime app uses the spv_app role which respects RLS.
DATABASE_URL=postgresql://spv_app:spv_app_dev_password@localhost:5432/spv_dev?schema=public
DATABASE_MIGRATE_URL=postgresql://spv:spv_dev_password@localhost:5432/spv_dev?schema=public

# ---- Redis ----
# Required. Backs rate limiting, idempotency, JWKS cache, and the public
# /status endpoint's degraded-mode detection.
REDIS_URL=redis://localhost:6379
# SVT-OPS-SINGLE-REPLICA-2026-05 — boot guard. When NODE_ENV=production and
# REDIS_URL is unset, server.ts refuses to start because step-up MFA state
# would be per-instance. Set to "true" only for an acknowledged single-replica
# deployment with no horizontal scaling. Leave unset / "false" in normal ops.
# SPV_ALLOW_SINGLE_REPLICA=false

# ---- JWT (RS256) ----
# In dev these are PEM strings on a single line with literal \n. Generate with:
#   openssl genpkey -algorithm RSA -out jwt_private.pem -pkeyopt rsa_keygen_bits:2048
#   openssl rsa -in jwt_private.pem -pubout -out jwt_public.pem
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...replace-me...\n-----END PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...replace-me...\n-----END PUBLIC KEY-----"
JWT_KID=dev-key-2026-05
JWT_ISSUER=spv-api
JWT_AUDIENCE=spv-app
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800
# SVT-SEC-IDLE-2026-05 — minutes of inactivity before refresh is rejected.
# OWASP default 30. Lower for high-security tenants, raise only with care.
IDLE_TIMEOUT_MIN=30

# ---- JWT key rotation (SVT-WAVE-JWT-ROTATE-2026-05) ----
# Optional overlap window for zero-downtime JWKS key rotation. See
# infra/docs/runbooks/jwt-key-rotation.md for the full procedure.
#
# NEXT pair: key rotating IN. Published in JWKS and accepted on verify, but
# NOT used for signing until promoted to JWT_PRIVATE_KEY/JWT_PUBLIC_KEY/JWT_KID.
# If JWT_PRIVATE_KEY_NEXT is set, JWT_PUBLIC_KEY_NEXT AND JWT_KID_NEXT are required.
# JWT_PRIVATE_KEY_NEXT="-----BEGIN PRIVATE KEY-----\n...next-key...\n-----END PRIVATE KEY-----"
# JWT_PUBLIC_KEY_NEXT="-----BEGIN PUBLIC KEY-----\n...next-key...\n-----END PUBLIC KEY-----"
# JWT_KID_NEXT=dev-key-2026-08
#
# PREV public key: key rotated OUT. Published in JWKS and accepted on verify so
# tokens signed before the rotation continue to validate until they expire.
# Drop this var after REFRESH_TOKEN_TTL_SECONDS has elapsed since promotion.
# JWT_PUBLIC_KEY_PREV="-----BEGIN PUBLIC KEY-----\n...prev-key...\n-----END PUBLIC KEY-----"
# JWT_KID_PREV=dev-key-2026-02

# ---- Encryption (envelope) ----
# Dev only: KEK as base64-encoded 32 bytes. Replace with KMS in staging/prod.
KMS_KEK_BASE64=

# SVT-WAVE-KMS-PROVIDER-2026-05 — KMS provider selection.
#   local — in-process AES-256-GCM (KEK from KMS_KEK_BASE64). Default. In
#           production, REFUSES to start unless KMS_LOCAL_OK=true (self-hosted
#           single-tenant operators only).
#   aws   — AwsKmsKms via @aws-sdk/client-kms (lazy-loaded; boot fails fast if
#           the dep is missing). Set KMS_KEY_ID to the key ARN / alias.
#   gcp   — GcpKmsKms via @google-cloud/kms (lazy-loaded). Set KMS_KEY_ID to
#           projects/<p>/locations/<l>/keyRings/<r>/cryptoKeys/<k>.
#   vault — reserved enum slot; getKms() throws until a class lands.
# KMS_PROVIDER=local
# KMS_KEY_ID=
# KMS_LOCAL_OK=
# KMS_AWS_REGION=

# SVT-WAVE-KMS-PROVIDER-2026-05 — P1-K3 + P1-K4: independent secrets so KMS
# / JWT rotation doesn't silently invalidate refresh-token lookups or
# audit-log correlation indexes. Required in production.
#   REFRESH_TOKEN_PEPPER  — HMAC pepper on refresh_tokens.token_hash (hex,64).
#   LOG_HMAC_KEY_BASE64   — HMAC key for ip_hash / ua_hash / email_hash
#                           (base64-encoded 32 bytes). Wins over the legacy
#                           CORRELATION_HMAC_KEY (hex,64) when both are set.
# REFRESH_TOKEN_PEPPER=
# LOG_HMAC_KEY_BASE64=
# CORRELATION_HMAC_KEY=

# ---- Default tenant + admin (used by seed) ----
SEED_TENANT_NAME="Default Tenant"
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMeNow!2026
SEED_ADMIN_GIVEN_NAME=System
SEED_ADMIN_FAMILY_NAME=Administrator

# ---- File storage ----
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=./storage

# ---- ClamAV (antivirus scan for uploads) ----
# Optional. When set, the public /status readiness probe pings clamd at
# CLAMAV_HOST:CLAMAV_PORT. Leave unset to disable the probe (uploads still
# work via the in-process scanner if your driver supports it).
# CLAMAV_HOST=localhost
# CLAMAV_PORT=3310

# ---- Rate limiting ----
RATE_LIMIT_GLOBAL_PER_MINUTE=600
# 5 attempts/min — protects against credential stuffing
RATE_LIMIT_AUTH_PER_MINUTE=5

# ---- Outbound email (Wave 7+) ----
# `log` for dev (no network); `resend` for staging/prod (requires RESEND_API_KEY).
# EMAIL_FROM must be a Resend-verified sender domain in prod.
EMAIL_PROVIDER=log
# RESEND_API_KEY=re_xxxxxxxxxxxx
EMAIL_FROM=noreply@spv.local

# ---- Error tracking + observability (Sentry) ----
# Leave SENTRY_DSN unset in dev (logger.warn fires once at boot; tracking disabled).
# In prod the boot fails-fast when set incorrectly via init's safeParse.
# SENTRY_DSN=https://<key>@oXXXXX.ingest.sentry.io/<project>
# Sample rates 0.0–1.0. tracesSampleRate is performance traces; errors always 100%.
SENTRY_TRACES_SAMPLE_RATE=0.05
SENTRY_RELEASE=
# GIT_COMMIT injected by CI for deploy markers; left empty in .env.example.
GIT_COMMIT=

# ---- Prometheus Metrics ----
# Bearer token for GET /metrics (required for scraper access; omit to disable endpoint).
# Generate with: openssl rand -hex 32
# METRICS_TOKEN=

# ---- V2 MIS read-only ingestion (TheNextMis CRM) ----
# SPVT mirrors visa-accepted leads from the external V2 CRM Postgres, READ-ONLY.
# All optional; ingest only runs when V2_INGEST_ENABLED=true.
#
# SECURITY (finance-grade, do before production):
#   1. Create a dedicated READ-ONLY role on the V2 DB (do NOT use `doadmin`):
#        CREATE ROLE spv_ro_ingest WITH LOGIN PASSWORD '<32+ random>';
#        GRANT CONNECT ON DATABASE defaultdb TO spv_ro_ingest;
#        GRANT USAGE ON SCHEMA public TO spv_ro_ingest;
#        GRANT SELECT ON ALL TABLES IN SCHEMA public TO spv_ro_ingest;
#        ALTER DEFAULT PRIVILEGES IN SCHEMA public GRANT SELECT ON TABLES TO spv_ro_ingest;
#      then rotate the doadmin password.
#   2. Prefer DO VPC private networking (same VPC as the V2 DB) → use the DB's
#      PRIVATE host. Removes the public IP-allowlist requirement entirely.
#      Fallback: add the app's stable egress IP to the DB's Trusted Sources.
#   3. Set V2_MIS_DATABASE_CA (DO CA bundle) for verified TLS in prod.
#   4. Store all secrets as DO App Platform encrypted env vars — never plaintext.
# V2_MIS_DATABASE_URL=postgresql://spv_ro_ingest:<pwd>@<private-host>:25060/defaultdb
V2_MIS_DATABASE_SSL=true
# CA bundle for full TLS verification (inline PEM or a file path). When unset,
# TLS falls back to encrypted-but-unverified with a loud warning (dev only).
# V2_MIS_DATABASE_CA=/run/secrets/v2-ca.crt
# Assert the V2 role is read-only at first connect (catalog reads only). Default true.
V2_MIS_ASSERT_READONLY=true
V2_INGEST_ENABLED=false
# V2_INGEST_TENANT_ID=<uuid of the SPVT tenant that owns the mirrored data>
V2_INGEST_DEFAULT_CURRENCY=NPR
