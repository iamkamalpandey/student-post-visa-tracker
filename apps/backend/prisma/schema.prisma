// ============================================================================
// 18. Commission claims (institution → consultancy)
// ============================================================================

enum CommissionStatus {
  PENDING
  CLAIMED
  INVOICED
  PAID
  DISPUTED
  WAIVED
}

model CommissionClaim {
  id                String           @id @default(uuid()) @db.Uuid
  tenant_id         String           @db.Uuid
  enrollment_id     String           @unique @db.Uuid
  institution_id    String           @db.Uuid
  student_id        String           @db.Uuid
  // Optional: which super-agent (aggregator/intermediary) the originating
  // enrollment was attributed to. Null for direct (no-broker) enrollments.
  // SetNull on super-agent delete to preserve historical claims.
  super_agent_id    String?          @db.Uuid
  amount_minor      BigInt
  currency          String           @db.Char(3)
  commission_pct    Decimal          @db.Decimal(5, 2)
  basis_minor       BigInt
  status            CommissionStatus @default(PENDING)
  claimed_on        DateTime?        @db.Date
  invoice_no        String?
  invoiced_on       DateTime?        @db.Date
  paid_on           DateTime?        @db.Date
  // SVT-FIN-2026-06 — amount actually received (minor). Null until paid; set at
  // mark-paid (defaults to amount_minor). amount_minor - received_minor is the
  // claimed-vs-received variance (short-payment / partial clawback).
  received_minor    BigInt?
  payment_reference String?
  dispute_reason    String?
  notes             String?
  version           Int              @default(1)
  created_at        DateTime         @default(now()) @db.Timestamptz
  created_by_id     String           @db.Uuid
  updated_at        DateTime         @updatedAt @db.Timestamptz
  updated_by_id     String?          @db.Uuid
  deleted_at        DateTime?        @db.Timestamptz

  // Restrict (not Cascade) so a hard-delete attempt on an enrollment with an
  // open commission claim surfaces an error instead of silently wiping the
  // financial record. Enrollments are soft-deleted via deleted_at in normal
  // operation — claims persist alongside.
  enrollment   Enrollment  @relation(fields: [enrollment_id], references: [id], onDelete: Restrict)
  institution  Institution @relation(fields: [institution_id], references: [id])
  student      Student     @relation(fields: [student_id], references: [id])
  currency_ref Currency    @relation(fields: [currency], references: [code])
  super_agent  SuperAgent? @relation(fields: [super_agent_id], references: [id], onDelete: SetNull)

  @@index([tenant_id, institution_id, status])
  @@index([tenant_id, status, claimed_on])
  @@index([student_id])
  @@index([super_agent_id])
  @@map("commission_claims")
}

// ============================================================================
// 19. Background-job observability
// ============================================================================
//
// Each invocation of a scheduled job (reminder.dispatcher, reminder.scanner,
// expiry.alerts, hash.anchor, retention.erasure, ...) writes a JobRun row so
// operators can answer "did the job run, did it succeed, how long did it
// take, what did it process?" without scraping logs. Rows are insert-then-
// update: the job inserts with status RUNNING and updates to SUCCEEDED /
// FAILED / PARTIAL / SKIPPED_LOCKED on completion.

enum JobRunStatus {
  RUNNING
  SUCCEEDED
  FAILED
  PARTIAL
  SKIPPED_LOCKED
}

model JobRun {
  id             String       @id @default(uuid()) @db.Uuid
  job_name       String
  started_at     DateTime     @default(now()) @db.Timestamptz
  finished_at    DateTime?    @db.Timestamptz
  status         JobRunStatus @default(RUNNING)
  rows_processed Int          @default(0)
  rows_failed    Int          @default(0)
  error_message  String?
  metadata       Json?

  @@index([job_name, started_at(sort: Desc)])
  @@map("job_runs")
}

// ============================================================================
// SVT-WAVE-BILLING-2026-05 — School/College-style fee management.
//
// Bounded context: billing tables hold NO FK to finance_items. FinanceItem
// stays for ad-hoc non-installment money (travel, accommodation,
// sponsorship, consultancy fee). Reporting that needs "all money" UNIONs
// the two by (tenant_id, student_id, enrollment_id) — never by FK.
//
// All tables gated by Tenant.billing_enabled (default false). Existing
// consultancy tenants see zero impact until they flip the flag.
//
// FSMs defined in apps/backend/src/modules/billing/fsm-def.ts.
// ============================================================================

enum FeePlanStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

enum FeeInstallmentStatus {
  SCHEDULED      // plan created, due_on in future, no invoice yet
  INVOICED       // invoice generated, awaiting payment
  DUE            // due_on reached
  OVERDUE        // past due_on + tenant.grace_days
  PARTIAL        // some allocations applied, balance > 0
  PAID           // balance = 0 via allocations
  WAIVED         // admin waiver (counts as paid for plan-completion)
  SUSPENDED      // plan paused (ON_LEAVE); reminders skip these
  CANCELLED      // plan cancelled before installment matured
  REFUNDED       // post-payment refund reversed the allocation
}

enum PaymentStatus {
  RECEIVED
  VOIDED
  PARTIALLY_REFUNDED
  REFUNDED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CARD
  CHEQUE
  OTHER
}

enum FeeAdjustmentKind {
  LATE_FEE       // positive amount; added to gross
  DISCOUNT       // negative; subtracted from gross
  SCHOLARSHIP    // negative; sub-type of discount, separately reportable
  WAIVER         // negative; cancels portion of balance with reason
  WRITE_OFF      // negative; tax/regulatory write-off
}

enum RefundStatus {
  PENDING
  COMPLETED
  FAILED
}

enum BillingCadence {
  MONTHLY
  QUARTERLY
  TRIMESTER
  SEMESTER
  TERM
  ANNUAL
  CUSTOM
}

// ---------------------------------------------------------------------------
// FeePlan — per-enrollment installment schedule. One ACTIVE plan per
// enrollment (enforced by partial unique index in migration SQL).
// Regeneration creates a new row + back-points the old via superseded_by_id.
// ---------------------------------------------------------------------------
model FeePlan {
  id                   String          @id @default(uuid()) @db.Uuid
  tenant_id            String          @db.Uuid
  enrollment_id        String          @db.Uuid
  cadence              BillingCadence
  total_minor          BigInt
  currency             String          @db.Char(3)
  scholarship_minor    BigInt          @default(0)
  status               FeePlanStatus   @default(DRAFT)
  starts_on            DateTime        @db.Date
  ends_on              DateTime?       @db.Date
  paused_at            DateTime?       @db.Timestamptz
  paused_reason        String?
  resumed_at           DateTime?       @db.Timestamptz
  superseded_by_id     String?         @db.Uuid
  // Optional per-tenant late-fee policy snapshot. Kept as JSON so the v1
  // doesn't need a separate policy table — promote when ≥3 tenants need
  // distinct curves. Shape: { grace_days, fee_minor | fee_pct, max_per_installment }.
  late_fee_policy      Json?
  notes                String?
  version              Int             @default(1)
  created_at           DateTime        @default(now()) @db.Timestamptz
  created_by_id        String?         @db.Uuid
  updated_at           DateTime        @updatedAt @db.Timestamptz
  updated_by_id        String?         @db.Uuid
  deleted_at           DateTime?       @db.Timestamptz

  tenant       Tenant         @relation(fields: [tenant_id], references: [id])
  enrollment   Enrollment     @relation(fields: [enrollment_id], references: [id], onDelete: Cascade)
  superseded_by FeePlan?      @relation("FeePlanSupersedes", fields: [superseded_by_id], references: [id])
  successors    FeePlan[]     @relation("FeePlanSupersedes")
  installments FeeInstallment[]

  @@index([tenant_id, status])
  @@index([tenant_id, enrollment_id])
  // Partial unique "one active plan per enrollment" lives in migration SQL
  // (Prisma can't express WHERE clauses on @@unique indexes yet).
  @@map("fee_plans")
}

// ---------------------------------------------------------------------------
// FeeInstallment — one row per scheduled payment in a FeePlan.
// State machine in apps/backend/src/modules/billing/fsm-def.ts.
// ---------------------------------------------------------------------------
model FeeInstallment {
  id                   String                @id @default(uuid()) @db.Uuid
  tenant_id            String                @db.Uuid
  fee_plan_id          String                @db.Uuid
  sequence_no          Int
  label                String
  due_on               DateTime              @db.Date
  // gross_minor = base scheduled amount (before adjustments).
  // net_minor  = gross + late_fees - discounts - waivers - write_offs.
  //              Recomputed inside FeeAdjustment write path.
  // paid_minor = SUM(PaymentAllocation.amount_minor) (cached on insert).
  // balance_minor = net - paid (cached; checked against allocation invariant).
  gross_minor          BigInt
  net_minor            BigInt
  paid_minor           BigInt                @default(0)
  balance_minor        BigInt
  currency             String                @db.Char(3)
  status               FeeInstallmentStatus  @default(SCHEDULED)
  version              Int                   @default(1)
  created_at           DateTime              @default(now()) @db.Timestamptz
  created_by_id        String?               @db.Uuid
  updated_at           DateTime              @updatedAt @db.Timestamptz
  updated_by_id        String?               @db.Uuid
  deleted_at           DateTime?             @db.Timestamptz

  tenant       Tenant              @relation(fields: [tenant_id], references: [id])
  fee_plan     FeePlan             @relation(fields: [fee_plan_id], references: [id], onDelete: Cascade)
  allocations  PaymentAllocation[]
  adjustments  FeeAdjustment[]

  @@unique([fee_plan_id, sequence_no])
  // Hot indexes for: overdue scan (status + due_on), dashboard outstanding
  // by tenant, per-plan listing.
  @@index([tenant_id, status, due_on])
  @@index([tenant_id, due_on])
  @@map("fee_installments")
}

// ---------------------------------------------------------------------------
// Payment — receipt of money from a student. Allocation across installments
// happens via PaymentAllocation rows (1:N).
// receipt_no is tenant-scoped via Postgres SEQUENCE + nextReceiptNo() fn.
// ---------------------------------------------------------------------------
model Payment {
  id                       String          @id @default(uuid()) @db.Uuid
  tenant_id                String          @db.Uuid
  student_id               String          @db.Uuid
  enrollment_id            String          @db.Uuid
  received_on              DateTime        @db.Date
  method                   PaymentMethod
  reference                String?
  receipt_no               String
  currency                 String          @db.Char(3)
  gross_minor              BigInt
  status                   PaymentStatus   @default(RECEIVED)
  notes                    String?
  version                  Int             @default(1)
  created_at               DateTime        @default(now()) @db.Timestamptz
  created_by_id            String?         @db.Uuid
  updated_at               DateTime        @updatedAt @db.Timestamptz
  updated_by_id            String?         @db.Uuid
  deleted_at               DateTime?       @db.Timestamptz

  tenant       Tenant              @relation(fields: [tenant_id], references: [id])
  student      Student             @relation(fields: [student_id], references: [id], onDelete: Cascade)
  enrollment   Enrollment          @relation(fields: [enrollment_id], references: [id], onDelete: Cascade)
  allocations  PaymentAllocation[]
  refunds      Refund[]

  @@unique([tenant_id, receipt_no])
  @@index([tenant_id, student_id, received_on(sort: Desc)])
  @@index([tenant_id, enrollment_id, status])
  // Perf P1 #3 — 30d payment aggregates filter by tenant + status + received_on
  // window. Avoids scanning all payments per dashboard refresh.
  @@index([tenant_id, status, received_on])
  @@map("payments")
}

// ---------------------------------------------------------------------------
// PaymentAllocation — distributes a Payment across one or more
// FeeInstallments. Invariant (DB CHECK + service guard):
//   SUM(amount_minor) per payment_id ≤ Payment.gross_minor
// Service may leave overflow as a StudentCredit row instead of allocating.
// ---------------------------------------------------------------------------
model PaymentAllocation {
  id                   String     @id @default(uuid()) @db.Uuid
  tenant_id            String     @db.Uuid
  payment_id           String     @db.Uuid
  fee_installment_id   String     @db.Uuid
  amount_minor         BigInt
  created_at           DateTime   @default(now()) @db.Timestamptz
  created_by_id        String?    @db.Uuid

  tenant         Tenant         @relation(fields: [tenant_id], references: [id])
  payment        Payment        @relation(fields: [payment_id], references: [id], onDelete: Cascade)
  fee_installment FeeInstallment @relation(fields: [fee_installment_id], references: [id], onDelete: Restrict)

  @@index([tenant_id, payment_id])
  @@index([tenant_id, fee_installment_id])
  @@map("payment_allocations")
}

// ---------------------------------------------------------------------------
// FeeAdjustment — per-installment add/sub. One row per adjustment for full
// audit trail (never edit in place). Late-fee cron writes LATE_FEE rows;
// admin waiver writes WAIVER row.
//
// amount_minor convention:
//   LATE_FEE   → positive   (adds to net)
//   DISCOUNT   → negative   (reduces net)
//   SCHOLARSHIP→ negative
//   WAIVER     → negative
//   WRITE_OFF  → negative
// ---------------------------------------------------------------------------
model FeeAdjustment {
  id                   String              @id @default(uuid()) @db.Uuid
  tenant_id            String              @db.Uuid
  fee_installment_id   String              @db.Uuid
  kind                 FeeAdjustmentKind
  amount_minor         BigInt
  reason_code          String?
  reason_text          String
  applied_on           DateTime            @db.Date
  created_at           DateTime            @default(now()) @db.Timestamptz
  created_by_id        String?             @db.Uuid

  tenant          Tenant         @relation(fields: [tenant_id], references: [id])
  fee_installment FeeInstallment @relation(fields: [fee_installment_id], references: [id], onDelete: Cascade)

  @@index([tenant_id, fee_installment_id])
  @@index([tenant_id, kind, applied_on])
  @@map("fee_adjustments")
}

// ---------------------------------------------------------------------------
// Refund — partial or full refund of a Payment. Two-step:
//   1. Admin creates Refund in PENDING.
//   2. Admin completes (or system auto-completes for CASH/CARD) → COMPLETED.
//      On completion, linked PaymentAllocations are reversed and underlying
//      installments transition INVOICED/PAID → REFUNDED.
// ---------------------------------------------------------------------------
model Refund {
  id                   String         @id @default(uuid()) @db.Uuid
  tenant_id            String         @db.Uuid
  payment_id           String         @db.Uuid
  amount_minor         BigInt
  refunded_on          DateTime?      @db.Date
  method               PaymentMethod
  reference            String?
  reason_code          String
  reason_text          String
  status               RefundStatus   @default(PENDING)
  notes                String?
  version              Int            @default(1)
  created_at           DateTime       @default(now()) @db.Timestamptz
  created_by_id        String?        @db.Uuid
  updated_at           DateTime       @updatedAt @db.Timestamptz
  updated_by_id        String?        @db.Uuid

  tenant   Tenant  @relation(fields: [tenant_id], references: [id])
  payment  Payment @relation(fields: [payment_id], references: [id], onDelete: Cascade)

  @@index([tenant_id, payment_id])
  @@index([tenant_id, status])
  // Perf P1 #3 — 30d refund aggregates filter by tenant + status + refunded_on
  // window (pairs with payments composite for symmetric dashboard queries).
  @@index([tenant_id, status, refunded_on])
  @@map("refunds")
}

// ---------------------------------------------------------------------------
// StudentCredit — overpayment carry-forward + refund-source credit.
// Created when:
//   - Payment.gross_minor exceeds sum of explicit allocations
//   - Refund of an installment that's already been waived/cancelled
//   - Manual admin credit (e.g. tenant goodwill gesture)
// Consumed by future PaymentAllocation rows (drawn down via consumed_minor).
// ---------------------------------------------------------------------------
model StudentCredit {
  id                   String     @id @default(uuid()) @db.Uuid
  tenant_id            String     @db.Uuid
  student_id           String     @db.Uuid
  enrollment_id        String?    @db.Uuid
  amount_minor         BigInt
  currency             String     @db.Char(3)
  source               String
  source_ref_id        String?    @db.Uuid
  consumed_minor       BigInt     @default(0)
  expires_on           DateTime?  @db.Date
  notes                String?
  created_at           DateTime   @default(now()) @db.Timestamptz
  created_by_id        String?    @db.Uuid
  updated_at           DateTime   @updatedAt @db.Timestamptz

  tenant     Tenant      @relation(fields: [tenant_id], references: [id])
  student    Student     @relation(fields: [student_id], references: [id], onDelete: Cascade)
  enrollment Enrollment? @relation(fields: [enrollment_id], references: [id], onDelete: SetNull)

  @@index([tenant_id, student_id])
  @@index([tenant_id, enrollment_id])
  @@map("student_credits")
}

// ============================================================================
// 30. CRM mirror (SVT-V2-CRM-MIRROR-2026-06)
//
// SPVT mirrors the external "V2 MIS" (TheNextMis) CRM relational model so the
// two are schema-compatible. Each table has three zones:
//   * V2 SOURCE      — faithful field copies, REFRESHED every sync.
//   * V2 EXTERNAL KEY — v2_*_id (Int) + source_system + synced_at; the dedup key.
//   * SPVT-OWNED      — local workflow + audit sextet; NEVER overwritten by sync.
// Internal relations use SPVT uuid FKs (not V2 ints); v2_*_id exists only for
// dedup + ingest FK resolution. Enums mirror V2 1:1 (Crm-prefixed). Money is
// BigInt minor + Char(3). V2 String dates are kept String (faithful, no parse).
// Replaces the earlier lightweight TrackedStudent/TrackedStudentFee tables.
// ============================================================================

