// 12. Documents
// ============================================================================

enum DocumentVerification {
  PENDING
  VERIFIED
  REJECTED
  EXPIRED
}

enum AvStatus {
  PENDING
  CLEAN
  INFECTED
  ERROR
}

model Document {
  id               String               @id @default(uuid()) @db.Uuid
  tenant_id        String               @db.Uuid
  student_id       String               @db.Uuid
  document_type_id String               @db.Uuid
  file_name        String
  storage_key      String               @unique
  mime_type        String
  size_bytes       Int
  sha256           String               @db.Char(64)
  av_status        AvStatus             @default(PENDING)
  av_scanned_at    DateTime?            @db.Timestamptz
  issued_on        DateTime?            @db.Date
  expires_on       DateTime?            @db.Date
  verification     DocumentVerification @default(PENDING)
  verified_at      DateTime?            @db.Timestamptz
  verified_by_id   String?              @db.Uuid
  retention_until  DateTime?            @db.Date
  version          Int                  @default(1)
  superseded_by_id String?              @db.Uuid
  created_at       DateTime             @default(now()) @db.Timestamptz
  created_by_id    String               @db.Uuid
  deleted_at       DateTime?            @db.Timestamptz

  tenant        Tenant       @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  student       Student      @relation(fields: [student_id], references: [id], onDelete: Cascade)
  document_type DocumentType @relation(fields: [document_type_id], references: [id])

  // Perf: documents_tenant_expiry_active_idx — partial(deleted_at IS NULL)
  // on (tenant_id, expires_on) for the expiry-alerts document scan. SQL-only (partial).
  @@index([student_id, document_type_id])
  @@index([sha256])
  @@index([tenant_id, expires_on])
  // Perf P1 #5 — retentionErasure pagination walks (tenant_id, retention_until)
  // ordered keyset scans to find documents past retention horizon.
  @@index([tenant_id, retention_until])
  @@map("documents")
}

// ============================================================================
// 13. Comms
// ============================================================================

enum CommsChannel {
  EMAIL
  SMS
  WHATSAPP
  IN_APP
}

model MessageTemplate {
  id                  String       @id @default(uuid()) @db.Uuid
  tenant_id           String       @db.Uuid
  key                 String
  channel             CommsChannel
  subject             String?
  body_md             String
  destination_country String?      @db.Char(2)
  stage_id            String?      @db.Uuid
  is_active           Boolean      @default(true)

  stage    LifecycleStage? @relation(fields: [stage_id], references: [id])
  messages CommsMessage[]

  @@unique([tenant_id, key, channel])
  @@map("message_templates")
}

model CommsThread {
  id         String       @id @default(uuid()) @db.Uuid
  tenant_id  String       @db.Uuid
  // Nullable so system-wide IN_APP transition notifications (super-agent
  // status flips, commission claim FSM events, etc.) can share a per-tenant
  // synthetic thread rather than spamming an arbitrary student's history.
  student_id String?      @db.Uuid
  channel    CommsChannel
  subject    String?
  created_at DateTime     @default(now()) @db.Timestamptz

  student  Student?       @relation(fields: [student_id], references: [id], onDelete: Cascade)
  messages CommsMessage[]

  @@index([student_id, channel])
  @@index([tenant_id, channel])
  @@map("comms_threads")
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageStatus {
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
}

model CommsMessage {
  id                String           @id @default(uuid()) @db.Uuid
  tenant_id         String           @db.Uuid
  thread_id         String           @db.Uuid
  // When set, the message is an in-app notification targeted at a staff user
  // (e.g. a reminder digest). Student-facing messages keep this null.
  recipient_user_id String?          @db.Uuid
  direction         MessageDirection
  status            MessageStatus    @default(QUEUED)
  subject           String?
  template_id       String?          @db.Uuid
  body              String
  sent_at           DateTime?        @db.Timestamptz
  delivered_at      DateTime?        @db.Timestamptz
  read_at           DateTime?        @db.Timestamptz
  provider_id       String?
  metadata          Json?
  created_by_id     String?          @db.Uuid
  created_at        DateTime         @default(now()) @db.Timestamptz
  // SVT-WAVE8-OUTBOX-2026-05 — outbox retry policy for external-provider
  // channels (EMAIL/SMS/WHATSAPP). attempts increments on every send try;
  // next_retry_at gates the comms.dispatcher job from picking the row up
  // before backoff has elapsed. Both stay null for IN_APP (no external send).
  attempts          Int              @default(0)
  last_attempt_at   DateTime?        @db.Timestamptz
  next_retry_at     DateTime?        @db.Timestamptz

  thread    CommsThread      @relation(fields: [thread_id], references: [id], onDelete: Cascade)
  template  MessageTemplate? @relation(fields: [template_id], references: [id])
  recipient User?            @relation("CommsRecipient", fields: [recipient_user_id], references: [id])

  @@index([tenant_id, thread_id, created_at])
  @@index([thread_id])
  @@index([tenant_id, recipient_user_id, read_at])
  // Partial index for the comms.dispatcher job (QUEUED + retryable FAILED).
  @@index([status, next_retry_at])
  @@map("comms_messages")
}

