// AcademicLevel — international study-abroad standard, ISCED-2011 aligned.
// Maps to: UK A-level/Foundation/PGDip/Masters/PhD, US HS/Associate/Bachelor/Master/Doctorate,
// AU Cert IV/Diploma/Adv Diploma/Bachelor/Grad Cert/Grad Dip/Master/PhD,
// CA College Diploma/Bachelor/Grad Cert/Master/PhD, EU/ISCED native.
enum AcademicLevel {
  PRIMARY                       // ISCED 1
  LOWER_SECONDARY               // ISCED 2 (middle school)
  UPPER_SECONDARY               // ISCED 3 (high school / A-level / IB / +2)
  POST_SECONDARY_NON_TERTIARY   // ISCED 4
  FOUNDATION                    // pathway / year-zero programs
  ASSOCIATE                     // ISCED 5 short-cycle
  DIPLOMA                       // vocational
  ADVANCED_DIPLOMA
  BACHELORS                     // ISCED 6
  GRADUATE_CERTIFICATE
  GRADUATE_DIPLOMA
  POSTGRADUATE_CERTIFICATE
  POSTGRADUATE_DIPLOMA
  MASTERS                       // ISCED 7
  MPHIL
  DOCTORATE                     // ISCED 8 (PhD)
  PROFESSIONAL                  // MBBS / JD / etc.
  CERTIFICATE
  OTHER
}

