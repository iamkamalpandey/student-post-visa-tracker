// Cross-process idempotency for write endpoints (imports.apply, bulk operations).
// The first request to use an Idempotency-Key inserts a row in PENDING status; subsequent
// requests with the same key see the row and return the cached result. Race-safe because
// the (tenant_id, scope, key) UNIQUE catches concurrent inserts at the DB level.
model IdempotencyRecord {
  id          String              @id @default(uuid()) @db.Uuid
  tenant_id   String              @db.Uuid
  // SVT-WAVE-BILLING-SEC-P1-F5 — user scoping. Two different users posting
  // the same Idempotency-Key on the same scope must produce two independent
  // records. NULL is reserved for non-user callers (webhooks, cron jobs).
  // Folded into the UNIQUE so the database refuses cross-user collisions.
  user_id     String?             @db.Uuid
  scope       String                                    // "imports.apply", "students.bulk", ...
  key         String
  request_hash String                                   // sha256 of the canonical request body
  status      IdempotencyStatus   @default(PENDING)
  status_code Int?
  response    Json?                                     // cached response body (after success)
  expires_at  DateTime            @db.Timestamptz       // 24h default
  created_at  DateTime            @default(now()) @db.Timestamptz
  completed_at DateTime?          @db.Timestamptz

  @@unique([tenant_id, user_id, scope, key])
  @@index([expires_at])
  @@map("idempotency_records")
}

enum IdempotencyStatus {
  PENDING
  SUCCESS
  FAILED
}

