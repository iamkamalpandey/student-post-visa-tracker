// SVT-FEDERATION-2026-06 — SPVT-owned overlay keyed by V2's lead id, INDEPENDENT
// of the crm_* mirror. This is the home for SPVT data when reading V2 LIVE
// (SPV_READ_MODE=live): no crm_leads row exists then, so the SPVT-owned fields
// (status/assignee/notes/student-link) + fees must hang off the V2 id directly.
// Island tables (scalar FK cols; real FKs + RLS in the migration) to keep them
// usable with or without the mirror.
model SpvLeadOverlay {
  id              String        @id @default(uuid()) @db.Uuid
  tenant_id       String        @db.Uuid
  v2_lead_id      Int
  spv_status      CrmLeadStatus @default(ACTIVE)
  assigned_to_id  String?       @db.Uuid
  spv_notes       String?
  student_id      String?       @unique @db.Uuid
  converted_at    DateTime?     @db.Timestamptz
  converted_by_id String?       @db.Uuid
  version         Int           @default(1)
  created_at      DateTime      @default(now()) @db.Timestamptz
  created_by_id   String?       @db.Uuid
  updated_at      DateTime      @updatedAt @db.Timestamptz
  updated_by_id   String?       @db.Uuid
  deleted_at      DateTime?     @db.Timestamptz
  deleted_by_id   String?       @db.Uuid

  @@unique([tenant_id, v2_lead_id], name: "spv_lead_overlay_v2_uq")
  @@index([tenant_id, assigned_to_id])
  @@index([deleted_at])
  @@map("spv_lead_overlay")
}

model SpvLeadFee {
  id                String       @id @default(uuid()) @db.Uuid
  tenant_id         String       @db.Uuid
  v2_lead_id        Int
  v2_application_id Int?
  session_label     String
