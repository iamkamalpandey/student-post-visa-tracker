enum EnrollmentStatus {
  OFFERED
  ACCEPTED
  ENROLLED
  // SVT-WAVE-BILLING-2026-05 — mid-enrolment leave. Triggers FeePlan pause.
  // FSM: ENROLLED ↔ ON_LEAVE → WITHDRAWN/COMPLETED.
  ON_LEAVE
  DEFERRED
  WITHDRAWN
  COMPLETED
  CANCELLED
}

model Enrollment {
  id                     String           @id @default(uuid()) @db.Uuid
  tenant_id              String           @db.Uuid
  student_id             String           @db.Uuid
  institution_id         String           @db.Uuid
  program_id             String           @db.Uuid
  program_intake_id      String?          @db.Uuid
  campus_id              String?          @db.Uuid
  enrollment_no          String?
  start_date             DateTime?        @db.Date
  expected_end_date      DateTime?        @db.Date
  actual_end_date        DateTime?        @db.Date
  status                 EnrollmentStatus @default(OFFERED)
  tuition_total_minor    BigInt?
  tuition_currency       String?          @db.Char(3)
  scholarship_minor      BigInt?          @default(0)
  scholarship_name       String?
  agent_commission_minor BigInt?
  // Super-agent that brokered this specific enrollment. Nullable because not
  // every enrollment goes through one (direct relationships exist). The link
  // is verified server-side against institution_super_agents — see
  // enrollments.service.ts.
  super_agent_id         String?          @db.Uuid
  notes                  String?
  // SVT-WAVE-BILLING-2026-05 — pause-window mirrors for fast filtering.
  // Authoritative state lives on FeePlan; these are caches set when the
  // enrollment transitions to ON_LEAVE so the reminderScanner + dashboard
  // queries can skip an extra join.
  paused_at              DateTime?        @db.Timestamptz
  resumed_at             DateTime?        @db.Timestamptz
  version                Int              @default(1)
  created_at             DateTime         @default(now()) @db.Timestamptz
  created_by_id          String?          @db.Uuid
  updated_at             DateTime         @updatedAt @db.Timestamptz
  updated_by_id          String?          @db.Uuid
  deleted_at             DateTime?        @db.Timestamptz

  student        Student        @relation(fields: [student_id], references: [id], onDelete: Cascade)
  institution    Institution    @relation(fields: [institution_id], references: [id])
  program        Program        @relation(fields: [program_id], references: [id])
  program_intake ProgramIntake? @relation(fields: [program_intake_id], references: [id])
  campus         Campus?        @relation(fields: [campus_id], references: [id])
  super_agent    SuperAgent?    @relation(fields: [super_agent_id], references: [id], onDelete: SetNull)
  finance_items  FinanceItem[]
  reminders      Reminder[]
  commission_claim CommissionClaim?
  // SVT-WAVE-BILLING-2026-05 — billing aggregate root. 1:1 with active plan.
  // History of regenerated plans is reachable via FeePlan.superseded_by_id.
  fee_plans      FeePlan[]
  payments       Payment[]
  student_credits StudentCredit[]

  @@index([student_id])
  @@index([institution_id, program_id])
  @@index([program_intake_id])
  @@index([super_agent_id])
  @@index([deleted_at])
  @@map("enrollments")
}

// ============================================================================
// Super-Agents — aggregator/intermediary platforms (Adventus, Edvoy, IDP,
// Apply Board, BUSY) that the consultancy uses to access institutions.
//
// Long-term design v2 (replaces v1 partial schema):
//   * SuperAgentType is an admin-configurable lookup (not a hardcoded enum) so
//     new categories (CONSORTIUM, GOVERNMENT, ...) can be added without a
//     schema migration.
//   * SuperAgentCommissionRule carries effective-date ranges so historical
//     rates are preserved when a deal renegotiates. Rules can be scoped to
//     all enrollments under a super-agent (default), to a specific
//     institution, or to a specific institution + program-level combo.
//   * Status lifecycle FSM (ACTIVE -> PAUSED / TERMINATED) lives in
//     modules/super-agents/fsm-def.ts and is registered with the shared
//     /api/v1/fsm/:machine/options router.
//   * Soft-delete + version columns for optimistic concurrency parity with
//     other business tables.
//   * Sub-processor link (sub_processor_id) lets admins register the agent for
//     GDPR/DPDP compliance with one click.
//
// Many-to-many relationship with Institution lives in InstitutionSuperAgent
// below: the same institution may be reachable through multiple super-agents.
// Per Enrollment we capture which super-agent — if any — was used for that
// specific case (drives commission attribution downstream via
// modules/commissions/commission-resolver.ts).
// ============================================================================

enum SuperAgentStatus {
  ACTIVE
  PAUSED
  TERMINATED
}

// Admin-configurable category lookup. Seeded with AGGREGATOR / REFERRAL_PARTNER /
// WHITE_LABEL / CONSORTIUM / GOVERNMENT but admins can add more rows from the
// /super-agent-types page without touching code.
model SuperAgentType {
  id          String   @id @default(uuid()) @db.Uuid
  tenant_id   String   @db.Uuid
  key         String
  label       String
  description String?
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now()) @db.Timestamptz
  updated_at  DateTime @updatedAt @db.Timestamptz

  tenant       Tenant       @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  super_agents SuperAgent[]

  @@unique([tenant_id, key])
  @@map("super_agent_types")
}

model SuperAgent {
  id                     String           @id @default(uuid()) @db.Uuid
  tenant_id              String           @db.Uuid
  type_id                String?          @db.Uuid
  name                   String
  short_name             String?
  legal_name             String?
  country_code           String?          @db.Char(2)
  website                String?
  logo_url               String?
  contact_email          String?
  contact_phone_e164     String?
  default_commission_pct Decimal?         @db.Decimal(5, 2)
  default_currency       String?          @db.Char(3)
  payment_terms_days     Int?
  status                 SuperAgentStatus @default(ACTIVE)
  // Legacy active flag — preserved for backwards compatibility with prior
  // FE/queries. New code should drive status; is_active is auto-derived
  // (status == ACTIVE => true, else false) by the service layer.
  is_active              Boolean          @default(true)
  notes                  String?
  // Optional sub-processor registration for GDPR/DPDP compliance.
  sub_processor_id       String?          @db.Uuid
  version                Int              @default(1)
  created_at             DateTime         @default(now()) @db.Timestamptz
  created_by_id          String?          @db.Uuid
  updated_at             DateTime         @updatedAt @db.Timestamptz
  updated_by_id          String?          @db.Uuid
  deleted_at             DateTime?        @db.Timestamptz

  tenant            Tenant                     @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  type              SuperAgentType?            @relation(fields: [type_id], references: [id], onDelete: SetNull)
  sub_processor     SubProcessor?              @relation(fields: [sub_processor_id], references: [id], onDelete: SetNull)
  contacts          SuperAgentContact[]
  commission_rules  SuperAgentCommissionRule[]
  institution_links InstitutionSuperAgent[]
  enrollments       Enrollment[]
  commission_claims CommissionClaim[]

  @@unique([tenant_id, name])
  @@index([tenant_id, status])
  @@index([tenant_id, type_id])
  @@map("super_agents")
}

model SuperAgentContact {
  id             String    @id @default(uuid()) @db.Uuid
  tenant_id      String    @db.Uuid
  super_agent_id String    @db.Uuid
  name           String
  role           String?
  email          String?
  phone_e164     String?
  is_primary     Boolean   @default(false)
  notes          String?
  created_at     DateTime  @default(now()) @db.Timestamptz
  updated_at     DateTime  @updatedAt @db.Timestamptz
  deleted_at     DateTime? @db.Timestamptz

  super_agent SuperAgent @relation(fields: [super_agent_id], references: [id], onDelete: Cascade)

  @@index([super_agent_id])
  @@map("super_agent_contacts")
}

// Commission rules with effective-date ranges. The most-specific applicable
// rule wins at calculation time (program-level override > institution-specific
// > super-agent default). Older rules are retained — never overwritten — for
// historical accuracy and audit.
model SuperAgentCommissionRule {
  id             String    @id @default(uuid()) @db.Uuid
  tenant_id      String    @db.Uuid
  super_agent_id String    @db.Uuid
  // Optional scope narrowers — null = applies to every link/program.
  institution_id String?   @db.Uuid
  // Stored as a string (matches AcademicLevel enum keys) so we don't pin this
  // table to the academic-level enum. Null = applies to every level.
  program_level  String?
  commission_pct Decimal   @db.Decimal(5, 2)
  currency       String    @db.Char(3)
  effective_from DateTime  @db.Date
  effective_to   DateTime? @db.Date
  notes          String?
  created_at     DateTime  @default(now()) @db.Timestamptz
  created_by_id  String?   @db.Uuid

  super_agent SuperAgent   @relation(fields: [super_agent_id], references: [id], onDelete: Cascade)
  institution Institution? @relation(fields: [institution_id], references: [id], onDelete: SetNull)

  @@index([tenant_id, super_agent_id, effective_from])
  @@index([tenant_id, institution_id, effective_from])
  @@map("super_agent_commission_rules")
}

// Pivot table: institution × super-agent. is_preferred is a soft signal admins
// use to nudge counsellors toward a preferred channel.
model InstitutionSuperAgent {
  id             String    @id @default(uuid()) @db.Uuid
  tenant_id      String    @db.Uuid
  institution_id String    @db.Uuid
  super_agent_id String    @db.Uuid
  is_preferred   Boolean   @default(false)
  notes          String?
  created_at     DateTime  @default(now()) @db.Timestamptz
  created_by_id  String?   @db.Uuid
  deleted_at     DateTime? @db.Timestamptz

  institution Institution @relation(fields: [institution_id], references: [id], onDelete: Cascade)
  super_agent SuperAgent  @relation(fields: [super_agent_id], references: [id], onDelete: Cascade)

  @@unique([institution_id, super_agent_id])
  @@index([tenant_id, institution_id])
  @@index([super_agent_id])
  @@map("institution_super_agents")
}

