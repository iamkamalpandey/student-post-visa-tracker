  visa_category_id    String      @db.Uuid
  visa_number_enc     Bytes
  destination_country String      @db.Char(2)
  issuing_post        String?
  issued_on           DateTime    @db.Date
  expires_on          DateTime    @db.Date
  entries             VisaEntries @default(MULTIPLE)
  conditions          String?
  is_active           Boolean     @default(true)
  // SVT-OCC-2026-05: optimistic-concurrency token. Bumped by every PATCH so an
  // If-Match: "<n>" header from the client can detect concurrent writers and
  // surface 412 Precondition Failed instead of silently overwriting.
  version             Int         @default(1)
  created_at          DateTime    @default(now()) @db.Timestamptz
  updated_at          DateTime    @updatedAt @db.Timestamptz

  student       Student      @relation(fields: [student_id], references: [id], onDelete: Cascade)
  visa_category VisaCategory @relation(fields: [visa_category_id], references: [id])
  destination   Country      @relation(fields: [destination_country], references: [code_alpha2])

  // Perf: student_visas_tenant_expiry_active_idx — partial(is_active = true)
  // on (tenant_id, expires_on) for the expiry-alerts scan. SQL-only (partial).
  @@index([student_id, is_active])
