// Student Post-Visa Tracker — full v3 schema.
// Conventions: snake_case columns, PascalCase models, UUID v7 PKs (uuid_generate_v7() preferred,
// app-side fallback via @spv/utils.uuidv7), @db.Timestamptz UTC timestamps, money as BigInt minor
// units + ISO 4217 FK, phones E.164, addresses normalised via shared Address. Every business
// table carries: tenant_id, version, created_at, created_by_id, updated_at, updated_by_id,
// deleted_at, deleted_by_id. RLS policies enforce tenant isolation in DB; Prisma client runs as
// non-superuser app role.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native"]
  engineType    = "binary"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// 1. Tenant, Users, Auth
// ============================================================================

model Tenant {
  id                    String   @id @default(uuid()) @db.Uuid
  name                  String
  legal_name            String?
  default_locale        String   @default("en")
  default_timezone      String   @default("UTC")
  default_currency      String   @default("USD") @db.Char(3)
  data_residency_region String   @default("eu-west-1")
  // SVT-WAVE15-FROM-2026-05 — per-tenant FROM address for outbound EMAIL.
  // Null falls back to env.EMAIL_FROM. Must be a verified sender domain on
  // the Resend account (set at tenant onboarding).
  email_from            String?
  // SVT-WAVE51-DEFAULT-CHANNEL-2026-05 — default outbound channel for new
  // message templates; FE seeds the channel select on dialog mount.
  // Column exists in DB (migration 235974 applied) but Prisma model field
  // is reintroduced once we can regen the client (`pnpm prisma generate`
  // requires backend dev server stopped on Windows due to query-engine
  // binary lock).
  // default_message_channel String @default("EMAIL")
  // SVT-WAVE-BILLING-2026-05 — opt-in flag for school/college-style billing.
  // Default false keeps every existing consultancy tenant on the flat-tuition
  // flow. When true, ACCEPTED→ENROLLED auto-generates a FeePlan and the FE
  // exposes the Billing tab + admin overview.
  billing_enabled       Boolean  @default(false)
  // SVT-SEC-MFA-ADMIN-POLICY-2026-05 (P1-A6) — opt-in tenant policy. When
  // true, requireMfa-gated routes reject ADMIN role requests with 403
  // `mfa_required_for_admin` until the acting admin has enrolled MFA. Default
  // false preserves the legacy pass-through for non-enrolled users so tenants
  // that haven't rolled MFA out yet keep working; flipping the toggle in
  // /settings → Security forces every admin to enrol before they can act.
  // Non-admin roles are untouched by this flag.
  require_mfa_for_admins Boolean  @default(false)
  is_active             Boolean  @default(true)
  created_at            DateTime @default(now()) @db.Timestamptz
  updated_at            DateTime @updatedAt @db.Timestamptz

  users           User[]
  students        Student[]
  stages          LifecycleStage[]
  institutions    Institution[]
  programs        Program[]
  documents       Document[]
  addresses       Address[]
  sub_processors  SubProcessor[]
  consents        ConsentRecord[]
  dsar_requests   DSARRequest[]
  audit_logs        AuditLog[]
  super_agents      SuperAgent[]
  super_agent_types SuperAgentType[]
  // SVT-WAVE-BILLING-2026-05 — billing aggregate roots.
  fee_plans          FeePlan[]
  fee_installments   FeeInstallment[]
  payments           Payment[]
  payment_allocations PaymentAllocation[]
  fee_adjustments    FeeAdjustment[]
  refunds            Refund[]
  student_credits    StudentCredit[]
  password_reset_tokens PasswordResetToken[]
  audit_anchors         AuditAnchor[]
  // SVT-V2-CRM-MIRROR-2026-06 — CRM mirror tables (read-mostly from V2 MIS).
  crm_countries         CrmCountry[]
  crm_institutions      CrmInstitution[]
  crm_courses           CrmCourse[]
  crm_leads             CrmLead[]
  crm_applications      CrmApplication[]
  crm_lead_courses      CrmLeadCourse[]
  crm_lead_course_history CrmLeadCourseHistory[]
  crm_payments          CrmPayment[]
  crm_remarks           CrmRemark[]
  crm_follow_ups        CrmFollowUp[]
  crm_call_history      CrmCallHistory[]
  crm_visits            CrmVisit[]
  crm_assignments       CrmAssignment[]
  crm_qualifications    CrmQualification[]
  crm_language_tests    CrmLanguageTest[]
  crm_guardians         CrmGuardian[]
  crm_lead_fees         CrmLeadFee[]
  interview_questions   InterviewQuestion[]
  interview_attempts    InterviewAttempt[]

  @@map("tenants")
}

model SubProcessor {
  id           String    @id @default(uuid()) @db.Uuid
  tenant_id    String    @db.Uuid
  name         String
  purpose      String
  region       String
  contract_url String?
  // GDPR Art. 28 — when the Data Processing Agreement was signed (null = not yet).
  dpa_signed_at      DateTime? @db.Timestamptz
  // GDPR Chapter V — international-transfer safeguard: ADEQUACY/SCC/BCR/DEROGATION/NONE.
  transfer_mechanism String?
  added_at     DateTime  @default(now()) @db.Timestamptz
  removed_at   DateTime? @db.Timestamptz

  tenant       Tenant       @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  // Reverse relation for SuperAgent.sub_processor_id — set when a super-agent
  // handling student PII is registered as a sub-processor for GDPR/DPDP compliance.
  super_agents SuperAgent[]

  @@index([tenant_id])
  @@map("sub_processors")
}

enum UserRole {
  ADMIN
  COUNSELLOR
  VIEWER
}

// SVT-WAVE14-DIGEST-2026-05 — email delivery cadence per user.
enum NotificationDigest {
  PER_EVENT
  DAILY
  OFF
}

model User {
  id                  String    @id @default(uuid()) @db.Uuid
  tenant_id           String    @db.Uuid
  email               String
  email_verified_at   DateTime? @db.Timestamptz
  password_hash       String
  given_name          String
  family_name         String
  display_name        String?
  role                UserRole  @default(COUNSELLOR)
  locale              String    @default("en")
  timezone            String    @default("UTC")
  is_active           Boolean   @default(true)
  last_login_at       DateTime? @db.Timestamptz
  failed_login_count  Int       @default(0)
  locked_until        DateTime? @db.Timestamptz
  password_changed_at DateTime? @db.Timestamptz
  mfa_enabled         Boolean   @default(false)
  mfa_secret_enc      Bytes?
  // SVT-SEC-MFA-RECOVERY-2026-05 — comma-joined sha256 hex hashes (64 chars each)
  // of the 10 single-use recovery codes minted at enrolment. Each successful
  // consumption removes one hash from the list. Cleared on disableMfa. Plain
  // text (not envelope-encrypted) because the values are already 256-bit hashes
  // of high-entropy codes; rainbow-table attacks aren't viable.
  mfa_recovery_hashes String?
  // SVT-WAVE8-EMAIL-2026-05 — opt-out per user. Reminder dispatcher checks
  // this before fanning out an EMAIL alongside the IN_APP notification.
  // Defaults to true so existing users keep getting alerted.
  notifications_email_enabled Boolean @default(true)
  // SVT-WAVE14-DIGEST-2026-05 — delivery cadence for EMAIL.
  //   PER_EVENT — send immediately as each event fires (existing behavior)
  //   DAILY     — collapse a day's events into one summary email at 08:00 UTC
  //   OFF       — same as notifications_email_enabled=false (compat shorthand)
  notifications_digest        NotificationDigest @default(PER_EVENT)
  // SVT-QA-2026-08 — session-wide access-token revoke. Any of these writes:
  //   changePassword / confirmPasswordReset / admin resetPassword / disableMfa /
  //   adminDisableMfa / revokeAllSessions
  // Stamps this to now(). authenticate middleware rejects a token whose iat is
  // older than sessions_valid_from — a stolen 15-minute-TTL access token is
  // invalidated within seconds of revocation instead of surviving to its TTL.
  sessions_valid_from DateTime? @db.Timestamptz
  created_at          DateTime  @default(now()) @db.Timestamptz
  updated_at          DateTime  @updatedAt @db.Timestamptz
  deleted_at          DateTime? @db.Timestamptz

  tenant            Tenant         @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  refresh_tokens    RefreshToken[]
  password_reset_tokens PasswordResetToken[]
  assigned_students Student[]      @relation("AssignedCounsellor")
  assigned_reminders Reminder[]    @relation("ReminderAssignee")
  inbox_messages    CommsMessage[] @relation("CommsRecipient")
  // SVT-V2-CRM-MIRROR-2026-06 — CRM leads this user owns.
  crm_assigned_leads CrmLead[] @relation("CrmLeadAssignee")

  // Perf indexes (see migrations/20991231235960_perf_indexes/migration.sql):
  //   * users_tenant_created_at_active_idx — partial (deleted_at IS NULL) on
  //     (tenant_id, created_at DESC, id DESC) for list pagination.
  //   * users_search_trgm_idx — GIN trgm on lower(email||given_name||family_name)
  //     for ILIKE search. Partial WHERE deleted_at IS NULL.
  // Both are SQL-only because Prisma @@index can't express partial indexes or
  // expression-based GIN indexes.
  @@unique([tenant_id, email])
  @@index([tenant_id, role])
  @@index([deleted_at])
  @@index([email])
  @@map("users")
}

model RefreshToken {
  id             String    @id @default(uuid()) @db.Uuid
  tenant_id      String    @db.Uuid
  user_id        String    @db.Uuid
  token_hash     String    @unique
  device_id      String?
  ua_hash        String?
  ip_subnet      String?
  issued_at      DateTime  @default(now()) @db.Timestamptz
  expires_at     DateTime  @db.Timestamptz
  revoked_at     DateTime? @db.Timestamptz
  // SVT-SEC-IDLE-2026-05 — bumped on every authenticated request (throttled 60s)
  // and on every successful refresh. Older than IDLE_TIMEOUT_MIN → refresh rejected.
  last_used_at   DateTime? @db.Timestamptz
  replaced_by_id String?   @db.Uuid

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([tenant_id])
  @@index([user_id, last_used_at])
  @@map("refresh_tokens")
}

model AccessTokenDenylist {
  jti        String   @id
  user_id    String   @db.Uuid
  tenant_id  String   @db.Uuid
  expires_at DateTime @db.Timestamptz

  @@map("access_token_denylist")
}

// SVT-SEC-2026-05 — Self-service password reset (NIST 800-63B + OWASP ASVS).
// Token is sha256-hashed at rest; raw token only delivered via email + URL.
// Single-use (consumed_at), 30-min TTL.
// SVT-AUDIT-WORM-2026-05 — Append-only Merkle roots of the audit chain.
// One row per (tenant_id, anchored_at). DB trigger blocks UPDATE/DELETE.
// Daily cron (hashAnchor.ts) inserts; external WORM replication reads.
model AuditAnchor {
  id                    String    @id @default(uuid()) @db.Uuid
  tenant_id             String?   @db.Uuid
  root_hash             String    @db.Char(64)
  entries_count         Int
  // Delta watermark — points at the last audit_logs row folded into this
  // anchor's root_hash. The next nightly run scans only rows past this point
  // and folds them onto root_hash, instead of re-hashing the entire chain.
  // Null on legacy rows written before SVT-PERF-AUDIT-ANCHOR-DELTA-2026-05;
  // computeTenantRoots() falls back to a from-scratch hash when null.
  last_entry_id         String?   @db.Uuid
  last_entry_created_at DateTime? @db.Timestamptz
  anchored_at           DateTime  @default(now()) @db.Timestamptz

  tenant Tenant? @relation(fields: [tenant_id], references: [id], onDelete: SetNull)

  @@unique([tenant_id, anchored_at])
  @@index([anchored_at])
  @@map("audit_anchors")
}

model PasswordResetToken {
  id              String    @id @default(uuid()) @db.Uuid
  tenant_id       String    @db.Uuid
  user_id         String    @db.Uuid
  token_hash      String    @unique @db.Char(64)
  requested_at    DateTime  @default(now()) @db.Timestamptz
  expires_at      DateTime  @db.Timestamptz
  consumed_at     DateTime? @db.Timestamptz
  invalidated_at  DateTime? @db.Timestamptz
  ip_hash         String?
  ua_hash         String?

  tenant Tenant @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [user_id],   references: [id], onDelete: Cascade)

  @@index([user_id, expires_at])
  @@index([tenant_id])
  @@map("password_reset_tokens")
}

enum LawfulBasis {
  CONSENT
  CONTRACT
  LEGAL_OBLIGATION
  VITAL_INTEREST
  PUBLIC_TASK
  LEGITIMATE_INTEREST
}

model ConsentRecord {
  id           String    @id @default(uuid()) @db.Uuid
  tenant_id    String    @db.Uuid
  subject_type String
  subject_id   String    @db.Uuid
  purpose      String
  lawful_basis LawfulBasis
  granted      Boolean
  // GDPR Art. 6(1)(f) legitimate-interests assessment (balancing test). Required
  // by the API when lawful_basis = LEGITIMATE_INTEREST (CreateConsentRequest).
  justification String?
  evidence     Json?
  granted_at   DateTime  @default(now()) @db.Timestamptz
  revoked_at   DateTime? @db.Timestamptz

  tenant Tenant @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@index([subject_type, subject_id])
  @@index([tenant_id])
  @@map("consent_records")
}

enum DSARType {
  ACCESS
  PORTABILITY
  ERASURE
  RECTIFICATION
  RESTRICTION
  OBJECTION
}

enum DSARStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  REJECTED
  EXPIRED
}

model DSARRequest {
  id                 String     @id @default(uuid()) @db.Uuid
  tenant_id          String     @db.Uuid
  subject_type       String
  subject_id         String     @db.Uuid
  type               DSARType
  status             DSARStatus @default(PENDING)
  requested_at       DateTime   @default(now()) @db.Timestamptz
  due_by             DateTime   @db.Timestamptz
  completed_at       DateTime?  @db.Timestamptz
  export_storage_key String?
  notes              String?

  tenant Tenant @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@index([tenant_id, status])
  @@index([subject_type, subject_id])
  @@map("dsar_requests")
}

model BreachIncident {
  id                      String    @id @default(uuid()) @db.Uuid
  tenant_id               String?   @db.Uuid
  detected_at             DateTime  @db.Timestamptz
  due_by                  DateTime  @db.Timestamptz                              // GDPR Art. 33 — 72h from detected_at
  reported_at             DateTime? @db.Timestamptz
  severity                String
  affected_subjects_count Int?
  description             String
  remediation             String?
  notification_sent       Boolean   @default(false)
  closed_at               DateTime? @db.Timestamptz

  @@index([tenant_id])
  @@index([due_by])                                                              // SLA dashboard / overdue list
  @@map("breach_incidents")
}

// ============================================================================
// 2. Reference / Lookup
// ============================================================================

model Country {
  code_alpha2  String  @id @db.Char(2)
  code_alpha3  String  @unique @db.Char(3)
  numeric_code String  @unique @db.Char(3)
  name         String
  dial_code    String
  is_active    Boolean @default(true)

  addresses               Address[]
  students                Student[]
  visas                   StudentVisa[]
  institutions            Institution[]
  visa_categories         VisaCategory[]
  airports                AirportIATA[]
  interview_questions     InterviewQuestion[]
  interview_attempts      InterviewAttempt[]

  @@map("countries")
}

model Currency {
  code       String  @id @db.Char(3)
  name       String
  minor_unit Int     @default(2)
  symbol     String?
  // SVT-LOOKUP-FILTERS-2026-05: deprecated ISO codes (ZRZ, ROL, TRL, XEU,
  // EEK, LVL, LTL, MTL, SIT, SKK, CYP, XAG, XAU, XPD, XPT) are seeded with
  // is_active = false so the picker stops emitting them. Currency is a
  // global table (not tenant-scoped) so no RLS migration is required.
  is_active  Boolean @default(true)

  finance_items     FinanceItem[]
  program_fees      ProgramFee[]
  commission_claims CommissionClaim[]

  @@map("currencies")
}

model IscedField {
  code  String @id @db.Char(4)
  label String

  @@map("isced_fields")
}

model AirlineIATA {
  iata String @id @db.Char(2)
  name String

  @@map("airlines_iata")
}

model AirportIATA {
  iata         String  @id @db.Char(3)
  name         String
  city         String
  country_code String  @db.Char(2)

  country Country @relation(fields: [country_code], references: [code_alpha2])

  @@index([country_code])
  @@map("airports_iata")
}

model VisaCategory {
  id           String  @id @default(uuid()) @db.Uuid
  country_code String  @db.Char(2)
  code         String
  name         String
  description  String?
  is_student   Boolean @default(true)
  is_active    Boolean @default(true)

  country Country       @relation(fields: [country_code], references: [code_alpha2])
  visas   StudentVisa[]

  @@unique([country_code, code])
  @@map("visa_categories")
}

model RelationshipType {
  id           String  @id @default(uuid()) @db.Uuid
  tenant_id    String  @db.Uuid
  key          String
  label        String
  is_guardian  Boolean @default(true)
  is_emergency Boolean @default(false)
  is_sponsor   Boolean @default(false)
  is_active    Boolean @default(true)

  contacts   StudentContact[]
  dependents StudentDependent[]

  @@unique([tenant_id, key])
  @@map("relationship_types")
}

model DocumentType {
  id             String  @id @default(uuid()) @db.Uuid
  tenant_id      String  @db.Uuid
  key            String
  label          String
  is_required    Boolean @default(false)
  has_expiry     Boolean @default(false)
  retention_days Int?
  is_active      Boolean @default(true)

  documents Document[]

  @@unique([tenant_id, key])
  @@map("document_types")
}

// ============================================================================
// 3. Dynamic Lifecycle
// ============================================================================

enum StageCategory {
  PRE_DEPARTURE
  IN_TRANSIT
  POST_ARRIVAL
  ENROLLED
  COMPLETED
  EXCEPTION
  IN_PROGRESS
}

model LifecycleStage {
  id                  String        @id @default(uuid()) @db.Uuid
  tenant_id           String        @db.Uuid
  key                 String
  label               String
  label_translations  Json?
  description         String?
  sequence            Int
  category            StageCategory @default(IN_PROGRESS)
  color_hex           String?       @db.Char(7)
  icon                String?
  is_initial          Boolean       @default(false)
  is_terminal         Boolean       @default(false)
  is_active           Boolean       @default(true)
  sla_hours           Int?
  destination_country String?       @db.Char(2)
  config_version      Int           @default(1)
  // v6: per-(country × visa-type) stages — null means "applies to any visa type".
  visa_type_id        String?       @db.Uuid
  // v6: outcome flags. Entering a stage with one of these flips downstream side
  // effects (commission recalc on success, reminder for failure). Mutually
  // exclusive — service guards 422 if both are true.
  is_outcome_success  Boolean       @default(false)
  is_outcome_failure  Boolean       @default(false)
  // v6: dashboard widget filter — opt-OUT (default true) so existing seeded stages
  // remain visible without backfill.
  show_on_dashboard   Boolean       @default(true)
  // v6: when set, AdvanceStageDialog renders an extra date input with this label
  // (e.g. "Departed on", "Arrived on"). The captured value lands in the lifecycle
  // event's metadata as `prompt_date`.
  prompt_date_label   String?
  created_at          DateTime      @default(now()) @db.Timestamptz
  updated_at          DateTime      @updatedAt @db.Timestamptz

  tenant   Tenant                     @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  visa_type VisaType?                 @relation(fields: [visa_type_id], references: [id], onDelete: SetNull)
  students Student[]                  @relation("CurrentStage")
  events   StudentLifecycleEvent[]    @relation("ToStage")
  events_from StudentLifecycleEvent[] @relation("FromStage")
  trans_from LifecycleStageTransition[] @relation("TransitionFrom")
  trans_to   LifecycleStageTransition[] @relation("TransitionTo")
  templates  MessageTemplate[]
  checklist_items LifecycleStageChecklistItem[]

  @@unique([tenant_id, key])
  @@index([tenant_id, sequence])
  @@index([visa_type_id])
  @@map("lifecycle_stages")
}

// v6: VisaType — per-tenant catalogue of visa workflows scoped by country.
// Stages may optionally pin themselves to a single VisaType via
// LifecycleStage.visa_type_id, or stay generic (visa_type_id = null) and apply
// across every visa type for the country.
//
// `is_generic` marks the tenant default per country and is guarded from rename /
// soft-delete by the service layer (so admins can't accidentally orphan default
// rows that downstream code relies on).
model VisaType {
  id              String    @id @default(uuid()) @db.Uuid
  tenant_id       String    @db.Uuid
  country_code    String    @db.Char(2)
  name            String
  short_name      String?
  description     String?
  is_active       Boolean   @default(true)
  is_generic      Boolean   @default(false)
  created_at      DateTime  @default(now()) @db.Timestamptz
  updated_at      DateTime  @updatedAt @db.Timestamptz
  deleted_at      DateTime? @db.Timestamptz

  stages          LifecycleStage[]

  @@unique([tenant_id, country_code, name])
  @@index([tenant_id, country_code])
  @@index([is_active])
  @@map("visa_types")
}

model LifecycleStageTransition {
  id            String    @id @default(uuid()) @db.Uuid
  tenant_id     String    @db.Uuid
  from_stage_id String    @db.Uuid
  to_stage_id   String    @db.Uuid
  requires_role UserRole?

  from_stage LifecycleStage @relation("TransitionFrom", fields: [from_stage_id], references: [id], onDelete: Cascade)
  to_stage   LifecycleStage @relation("TransitionTo", fields: [to_stage_id], references: [id], onDelete: Cascade)

  @@unique([tenant_id, from_stage_id, to_stage_id])
  @@index([tenant_id])
  @@map("lifecycle_stage_transitions")
}

// Per-stage checklist tasks. Counsellors track what must happen during each stage
// (e.g. "Pre-departure briefing" stage → 6 items). Soft-deletable via deleted_at.
model LifecycleStageChecklistItem {
  id          String    @id @default(uuid()) @db.Uuid
  tenant_id   String    @db.Uuid
  stage_id    String    @db.Uuid
  label       String
  description String?
  sequence    Int       @default(0)
  is_required Boolean   @default(true)
  sla_hours   Int?
  is_active   Boolean   @default(true)
  created_at  DateTime  @default(now()) @db.Timestamptz
  updated_at  DateTime  @updatedAt @db.Timestamptz
  deleted_at  DateTime? @db.Timestamptz

  stage    LifecycleStage                  @relation(fields: [stage_id], references: [id], onDelete: Cascade)
  progress StudentStageChecklistProgress[]

  @@index([stage_id, sequence])
  @@index([tenant_id])
  @@map("lifecycle_stage_checklist_items")
}

// Per-student progress against a single checklist item. Toggling completed
// flips completed_at + completed_by_id; uniqueness on (student_id, checklist_item_id).
model StudentStageChecklistProgress {
  id                String    @id @default(uuid()) @db.Uuid
  tenant_id         String    @db.Uuid
  student_id        String    @db.Uuid
  stage_id          String    @db.Uuid
  checklist_item_id String    @db.Uuid
  completed_at      DateTime? @db.Timestamptz
  completed_by_id   String?   @db.Uuid
  notes             String?
  created_at        DateTime  @default(now()) @db.Timestamptz
  updated_at        DateTime  @updatedAt @db.Timestamptz

  student        Student                     @relation(fields: [student_id], references: [id], onDelete: Cascade)
  checklist_item LifecycleStageChecklistItem @relation(fields: [checklist_item_id], references: [id], onDelete: Cascade)

  @@unique([student_id, checklist_item_id])
  @@index([tenant_id, stage_id])
  @@map("student_stage_checklist_progress")
}

// ============================================================================
// 4. Student core
// ============================================================================

enum Gender {
  NOT_KNOWN
  MALE
  FEMALE
  NOT_APPLICABLE
}

enum MaritalStatus {
  SINGLE
  MARRIED
  CIVIL_PARTNERSHIP
  SEPARATED
  DIVORCED
  WIDOWED
  OTHER
}

enum StudentStatus {
  ACTIVE
  ON_HOLD
  // SVT-WAVE-BILLING-2026-05 — ON_LEAVE is distinct from DEFERRED:
  // DEFERRED = pre-start postponement; ON_LEAVE = mid-enrolment pause.
  // Pauses fee installments + suppresses payment-due reminders.
  ON_LEAVE
  WITHDRAWN
  COMPLETED
  DEFERRED
}

model Student {
  id                    String        @id @default(uuid()) @db.Uuid
  tenant_id             String        @db.Uuid
  student_code          String
  given_name            String
  middle_name           String?
  family_name           String
  preferred_name        String?
  name_in_passport_enc  Bytes
  date_of_birth         DateTime      @db.Date
  gender                Gender        @default(NOT_KNOWN)
  gender_self_described String?
  nationality_code      String        @db.Char(2)
  marital_status        MaritalStatus?
  primary_language      String        @default("en")
  // Optional self-declared identity fields (kept free-text deliberately — closed
  // enums are culturally fraught for these). Storage only; not used for filtering.
  religion              String?
  ethnicity             String?
  email_primary         String?
  email_secondary       String?
  phone_primary_e164    String?
  phone_secondary_e164  String?
  current_stage_id      String        @db.Uuid
  stage_entered_at      DateTime      @default(now()) @db.Timestamptz
  status                StudentStatus @default(ACTIVE)
  assigned_to_id        String?       @db.Uuid
  notes                 String?
  completeness_pct      Int           @default(0)
  version               Int           @default(1)
  created_at            DateTime      @default(now()) @db.Timestamptz
  created_by_id         String?       @db.Uuid
  updated_at            DateTime      @updatedAt @db.Timestamptz
  updated_by_id         String?       @db.Uuid
  deleted_at            DateTime?     @db.Timestamptz
  deleted_by_id         String?       @db.Uuid

  tenant         Tenant         @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  current_stage  LifecycleStage @relation("CurrentStage", fields: [current_stage_id], references: [id])
  assigned_to    User?          @relation("AssignedCounsellor", fields: [assigned_to_id], references: [id], onDelete: SetNull)
  nationality    Country        @relation(fields: [nationality_code], references: [code_alpha2])

  addresses        StudentAddress[]
  identifications  StudentIdentification[]
  visas            StudentVisa[]
  regulator_ids    StudentRegulatorIdentifier[]
  qualifications   AcademicQualification[]
  language_tests   LanguageTestResult[]
  contacts         StudentContact[]
  dependents       StudentDependent[]
  employments      StudentEmployment[]
  compliance       ComplianceCheck[]
  engagements      EngagementCheck[]
  enrollments      Enrollment[]
  travel           TravelRecord[]
  accommodations   Accommodation[]
  insurances       InsuranceRecord[]
  finance_items    FinanceItem[]
  sponsorships     StudentSponsorship[]
  documents        Document[]
  crm_lead         CrmLead?               @relation("CrmLeadStudent")
  lifecycle_events StudentLifecycleEvent[]
  comms_threads    CommsThread[]
  reminders        Reminder[]
  commission_claims CommissionClaim[]
  stage_checklist_progress StudentStageChecklistProgress[]
  // SVT-WAVE-BILLING-2026-05 — receipts + carry-forward credits live at
  // student scope (a student may have multiple enrolments over time).
  payments         Payment[]
  student_credits  StudentCredit[]
  interview_attempts InterviewAttempt[]

  // Perf indexes (see migrations/20991231235960_perf_indexes/migration.sql):
  //   * students_tenant_stage_active_idx       — partial(deleted_at IS NULL) on (tenant_id, current_stage_id) for dashboard groupBy.
  //   * students_tenant_status_active_idx      — partial(deleted_at IS NULL) on (tenant_id, status) for dashboard groupBy.
  //   * students_tenant_assigned_active_idx    — partial(deleted_at IS NULL) on (tenant_id, assigned_to_id) for "my students".
  //   * students_tenant_created_at_active_idx  — partial(deleted_at IS NULL) on (tenant_id, created_at DESC, id DESC) for list pagination.
  //   * students_search_trgm_idx               — partial(deleted_at IS NULL) GIN trgm on lower(family_name||given_name||student_code) for ILIKE search.
  // All are SQL-only — Prisma @@index can't express partial indexes or expression-based GIN indexes.
  @@unique([tenant_id, student_code])
  @@unique([tenant_id, email_primary])
  @@index([tenant_id, current_stage_id, assigned_to_id])
  @@index([tenant_id, status])
  @@index([tenant_id, family_name, given_name])
  @@index([deleted_at])
  @@map("students")
}

