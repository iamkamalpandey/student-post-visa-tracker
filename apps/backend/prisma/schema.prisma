// ---------------------------------------------------------------------------
// Visa Interview Prep — mock interview practice for students
// ---------------------------------------------------------------------------

enum InterviewQuestionCategory {
  GENERAL
  ACADEMIC
  FINANCIAL
  TIES_TO_HOME
  FUTURE_PLANS
  PERSONAL
  I20_ANALYSIS
  DOCUMENT
}

enum InterviewAttemptStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

model InterviewQuestion {
  id             String                      @id @default(uuid()) @db.Uuid
  tenant_id      String                      @db.Uuid
  country_code   String                      @db.Char(2)
  academic_level AcademicLevel?
  institution_id String?                     @db.Uuid
  category       InterviewQuestionCategory
  question_text  String
  model_answer   String?
  tips           String?
  sort_order     Int                         @default(0)
  is_active      Boolean                     @default(true)
  version        Int                         @default(1)
  created_at     DateTime                    @default(now()) @db.Timestamptz
  created_by_id  String?                     @db.Uuid
  updated_at     DateTime                    @updatedAt @db.Timestamptz
  updated_by_id  String?                     @db.Uuid
  deleted_at     DateTime?                   @db.Timestamptz
  deleted_by_id  String?                     @db.Uuid

  tenant      Tenant       @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  country     Country      @relation(fields: [country_code], references: [code_alpha2])
  institution Institution? @relation(fields: [institution_id], references: [id])
  answers     InterviewAnswer[]

  @@index([tenant_id, country_code, is_active])
  @@index([tenant_id, institution_id])
  @@index([deleted_at])
  @@map("interview_questions")
}

model InterviewAttempt {
  id               String                   @id @default(uuid()) @db.Uuid
  tenant_id        String                   @db.Uuid
  student_id       String?                  @db.Uuid
  candidate_name   String
  candidate_email  String
  country_code     String                   @db.Char(2)
  institution_name String
  institution_id   String?                  @db.Uuid
  course_name      String
  academic_level   AcademicLevel
  intake_label     String
  has_i20          Boolean                  @default(false)
  question_count   Int                      @default(0)
  answered_count   Int                      @default(0)
  status           InterviewAttemptStatus   @default(IN_PROGRESS)
  started_at       DateTime                 @default(now()) @db.Timestamptz
  completed_at     DateTime?                @db.Timestamptz
  version          Int                      @default(1)
  created_at       DateTime                 @default(now()) @db.Timestamptz
  updated_at       DateTime                 @updatedAt @db.Timestamptz

  tenant      Tenant       @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  student     Student?     @relation(fields: [student_id], references: [id])
  institution Institution? @relation(fields: [institution_id], references: [id])
  country     Country      @relation(fields: [country_code], references: [code_alpha2])
  answers     InterviewAnswer[]

  @@index([tenant_id, status])
  @@index([tenant_id, candidate_email])
  @@index([student_id])
  @@map("interview_attempts")
}

model InterviewAnswer {
  id                 String   @id @default(uuid()) @db.Uuid
  attempt_id         String   @db.Uuid
  question_id        String   @db.Uuid
  answer_text        String
  answered_at        DateTime @default(now()) @db.Timestamptz
  time_spent_seconds Int?

  attempt  InterviewAttempt  @relation(fields: [attempt_id], references: [id], onDelete: Cascade)
  question InterviewQuestion @relation(fields: [question_id], references: [id])

  @@unique([attempt_id, question_id])
  @@index([attempt_id])
  @@map("interview_answers")
}
