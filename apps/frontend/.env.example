# ---- API / branding ----
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_APP_NAME="Student Post-Visa Tracker"

# ---- Public surfaces (legal pages, support, status) ----
# SVT-WAVE-STATUS-PUBLIC-2026-05 — link target for the legal/support "Status
# page" row. Defaults to the in-app /status route. Override with an absolute
# URL (e.g. https://status.example.com) when fronting the platform with a
# third-party status provider.
NEXT_PUBLIC_STATUS_URL=/status
# Address shown on /legal/privacy, /legal/terms, /legal/support as the
# contact mailbox. Must be a monitored inbox in prod (DSAR, security reports,
# and billing disputes route here). Defaults to support@example.com if unset.
NEXT_PUBLIC_SUPPORT_EMAIL=support@example.com
