# Root .env hints. Real per-app envs live in apps/backend/.env and apps/frontend/.env.local.
# This file is committed; never put real secrets here.

# ---- docker-compose.yml (dev) ----
# Common pointers (used by docker-compose and infra scripts)
POSTGRES_USER=spv
POSTGRES_PASSWORD=spv_dev_password
POSTGRES_DB=spv_dev

# ---- docker-compose.prod.yml overrides ----
# Required when running `docker compose -f docker-compose.yml -f docker-compose.prod.yml up`.
# These shadow the dev defaults above and inject straight into the postgres
# container + backend service. Never check in real values.
PG_OWNER=spv
PG_OWNER_PASSWORD=replace-with-strong-password
PG_DB=spv_prod

# Backend service envs consumed by docker-compose.prod.yml (referenced by
# ${VAR:?required} — compose refuses to start until each is set). Mirror the
# apps/backend/.env.example file for full descriptions of each var.
CORS_ORIGIN=https://app.example.com
DATABASE_URL=postgresql://spv_app:replace-me@postgres:5432/spv_prod?schema=public
DATABASE_MIGRATE_URL=postgresql://spv:replace-me@postgres:5432/spv_prod?schema=public
REDIS_URL=redis://redis:6379
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...replace-me...\n-----END PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...replace-me...\n-----END PUBLIC KEY-----"
JWT_KID=prod-key-2026-05
KMS_KEK_BASE64=replace-with-32-byte-base64-string
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMeNow!2026
EMAIL_FROM=noreply@example.com
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=re_replace_me

# Frontend build-time args baked into the Next.js image at `docker compose build`.
NEXT_PUBLIC_API_BASE_URL=https://api.example.com/api/v1
NEXT_PUBLIC_APP_NAME="Student Post-Visa Tracker"

# ---- Database backups (.github/workflows/db-backup.yml + infra/scripts/) ----
# Consumed by infra/scripts/backup-snapshot.sh and restore-from-snapshot.sh.
# In CI these come from GitHub Actions secrets; locally export them in your
# shell before invoking the scripts manually. NEVER write real values here.
#
# BACKUP_BUCKET       S3 bucket name (no s3:// prefix). Where pgdumps land.
# BACKUP_LABEL        Object name prefix (default: "svt"). e.g. "svt-prod".
# BACKUP_PUBKEY       `age` recipient pubkey (age1...). If set, dump is
#                     encrypted with `age` before upload. Strongly recommended.
# BACKUP_S3_TOOL      "aws" (default) or "rclone".
# BACKUP_RCLONE_REMOTE  rclone remote name when BACKUP_S3_TOOL=rclone (default "s3").
# BACKUP_AGE_IDENTITY Path to age identity file (restore-side only, for .age dumps).
# BACKUP_BUCKET=svt-prod-backups
# BACKUP_LABEL=svt-prod
# BACKUP_PUBKEY=age1examplepublickeyreplaceme
# BACKUP_S3_TOOL=aws
# BACKUP_RCLONE_REMOTE=s3
# BACKUP_AGE_IDENTITY=/path/to/age-identity.txt
